# Proofs of the Adler-32 C contracts.  Needs the pinned toolchain,
# including VST, and the Rocq sources of the specification layers built.
#
#   make        translate the patched adler32.c, check every proof, and
#               check that the proofs rest on allowed axioms only
#   make clean  remove build products
#
# Run `make check` at the top of the repository first.  It builds the
# specification layers and the patched tree that these proofs depend on.
#
# adler32_clight.v is generated by clightgen for whatever target the local
# CompCert was built for.  The results that count are those for the
# project's first target, x86-64 Linux: run `make full` at the top through
# tools/in-container.sh.  These proofs are not part of `make check`.

ROOT    := ../..
PATCHED := $(ROOT)/build/zlib-patched
FLAGS   := -Q . fvzlib.proofs.adler32 -Q $(ROOT)/proofs/lib fvzlib.proofs.lib \
           -Q $(ROOT)/spec/format fvzlib.format -Q $(ROOT)/spec/api fvzlib.api
include $(ROOT)/proofs/zlib.mk
DEFINES := $(ZLIB_DEFINES)
FILES   := adler32_clight Bridge Model Steps Buffer Spec Verif VerifWrapper \
           EmptyBuffer Contract ContractProof ContractReview Combine \
           CensusAdler32 CombineGuarded

.PHONY: all clean
all: adler32_clight.v
	$(MAKE) -C $(ROOT)/proofs/lib
	for f in $(FILES); do rocq compile $(FLAGS) $$f.v || exit 1; done
	python3 $(ROOT)/tools/check_axioms.py --flags '$(FLAGS)' .

adler32_clight.v: $(PATCHED)/adler32.c
	clightgen -normalize -I $(PATCHED) $(DEFINES) $(PATCHED)/adler32.c \
	  -o adler32_clight.v

clean:
	rm -f *.vo *.vok *.vos *.glob .*.aux adler32_clight.v
