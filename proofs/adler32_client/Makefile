# A whole program that calls every function of adler32.c, and what is
# proven about how it runs.  Needs the pinned toolchain, including VST,
# and proofs/adler32 built.
#
#   make        translate client.c, check every file, and check what the
#               results rest on
#   make clean  remove build products
#
# client_clight.v is generated by clightgen from client.c, which includes
# the patched adler32.c.  The results that count are those for the
# project's first target, x86-64 Linux.

ROOT    := ../..
PATCHED := $(ROOT)/build/zlib-patched
FLAGS   := -Q . fvzlib.proofs.adler32_client \
           -Q $(ROOT)/proofs/adler32 fvzlib.proofs.adler32 \
           -Q $(ROOT)/proofs/lib fvzlib.proofs.lib \
           -Q $(ROOT)/spec/format fvzlib.format -Q $(ROOT)/spec/api fvzlib.api
include $(ROOT)/proofs/zlib.mk
DEFINES := $(ZLIB_DEFINES)
FILES   := client_clight Client Guarded

.PHONY: all clean
all: client_clight.v
	for f in $(FILES); do rocq compile $(FLAGS) $$f.v || exit 1; done
	python3 $(ROOT)/tools/check_axioms.py --flags '$(FLAGS)' \
	  --also $(ROOT)/audit/execution-axioms.txt .

client_clight.v: client.c $(PATCHED)/adler32.c
	clightgen -normalize -I $(PATCHED) $(DEFINES) client.c -o client_clight.v

clean:
	rm -f *.vo *.vok *.vos *.glob .*.aux client_clight.v
