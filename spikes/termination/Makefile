# Termination spike.  Needs the pinned toolchain, including VST.
#
#   make        translate the patched adler32.c and check every file
#   make clean  remove build products
#
# The patched tree must exist first: run `python3 tools/check_patches.py`
# at the top of the repository.  adler32.v is generated by clightgen for
# whatever target the local CompCert was built for.  This spike is
# exploratory and is not part of `make check` at the top.

PATCHED := ../../build/zlib-patched
FLAGS   := -Q . "" -Q ../transfer ""
include ../../proofs/zlib.mk
DEFINES := $(ZLIB_DEFINES)
FILES   := adler32 adler32_ticked Buffer verif_adler32_z_cost verif_adler32_cost

.PHONY: all clean
all: adler32.v
	$(MAKE) -C ../transfer
	for f in $(FILES); do rocq compile $(FLAGS) $$f.v || exit 1; done

adler32.v: $(PATCHED)/adler32.c
	clightgen -normalize -I $(PATCHED) $(DEFINES) $(PATCHED)/adler32.c -o adler32.v

clean:
	rm -f *.vo *.vok *.vos *.glob .*.aux adler32.v
