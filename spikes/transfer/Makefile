# Contract transfer spike.  Needs the pinned toolchain, including VST.
#
#   make        translate the toy with CompCert and check every file
#   make clean  remove build products
#
# toy.v is generated by clightgen for whatever target the local CompCert was
# built for.  This spike is exploratory and is not part of `make check` at
# the top of the repository.

FLAGS := -Q . "" -Q ../../proofs/lib fvzlib.proofs.lib
FILES := toy GotoElim toy_nogoto verif_toy_nogoto toy_ticked \
         verif_toy_ticked Transfer TickStatements TickBound

.PHONY: all clean
all: toy.v
	$(MAKE) -C ../../proofs/lib
	for f in $(FILES); do rocq compile $(FLAGS) $$f.v || exit 1; done
	python3 ../../tools/check_axioms.py --flags '$(FLAGS)' .

toy.v: toy.c
	clightgen -normalize toy.c -o toy.v

clean:
	rm -f *.vo *.vok *.vos *.glob .*.aux toy.v
